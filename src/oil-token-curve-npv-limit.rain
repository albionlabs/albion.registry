          name: P1 Y4 BP3
        - binding: db-y4-bp4
          name: P1 Y4 BP4
        - binding: db-y4-bp5
          name: P1 Y4 BP5
        - binding: db-y5-bp0
          name: P1 Terminal BP0
        - binding: db-y5-bp1
