          description: Select the payment token you want to receive

---
#raindex-subparser !Raindex subparser.

#oracle-signer !Trusted oracle signer address (EIP-191 signer of the curve frame).
#oracle-schema-version !Expected frame schema version (= 1).

#target-io-fn !Function computing the quoted io ratio (sell floor or buy inverse).

#benchmark-id !Product 1 benchmark: 1=Brent 2=WTI 3=NBP 4=TTF.
#benchmark-2-id !Product 2 benchmark; 0 disables product 2.
#meta-hash !Hash of the canonical asset metadata baked at deploy time.
#start-time !Unix timestamp anchoring grid breakpoint 0.
#bp-horizon !Seconds spanned by the 5 grid segments; order halts past start-time + bp-horizon.

#year-0 !Calendar year of bucket 0 (deploy year; oracle key holds Bal average).
#year-1 !Calendar year of bucket 1.
#year-2 !Calendar year of bucket 2.
#year-3 !Calendar year of bucket 3.
#year-4 !Calendar year of bucket 4; also prices the terminal bucket (strip-then-flat).

/* Curve-NPV grid (deploy-time scalars from computeBucketNpvGrid).
   Same layout as oil-token-curve-npv-dca.rain -- see that file. */
#db-y0-bp0 !P1 bucket 0 anchor 0.
#db-y0-bp1 !P1 bucket 0 anchor 1.
#db-y0-bp2 !P1 bucket 0 anchor 2.
#db-y0-bp3 !P1 bucket 0 anchor 3.
#db-y0-bp4 !P1 bucket 0 anchor 4.
#db-y0-bp5 !P1 bucket 0 anchor 5.
#db-y1-bp0 !P1 bucket 1 anchor 0.
#db-y1-bp1 !P1 bucket 1 anchor 1.
#db-y1-bp2 !P1 bucket 1 anchor 2.
#db-y1-bp3 !P1 bucket 1 anchor 3.
#db-y1-bp4 !P1 bucket 1 anchor 4.
#db-y1-bp5 !P1 bucket 1 anchor 5.
#db-y2-bp0 !P1 bucket 2 anchor 0.
#db-y2-bp1 !P1 bucket 2 anchor 1.
#db-y2-bp2 !P1 bucket 2 anchor 2.
#db-y2-bp3 !P1 bucket 2 anchor 3.
#db-y2-bp4 !P1 bucket 2 anchor 4.
#db-y2-bp5 !P1 bucket 2 anchor 5.
#db-y3-bp0 !P1 bucket 3 anchor 0.
#db-y3-bp1 !P1 bucket 3 anchor 1.
#db-y3-bp2 !P1 bucket 3 anchor 2.
#db-y3-bp3 !P1 bucket 3 anchor 3.
#db-y3-bp4 !P1 bucket 3 anchor 4.
#db-y3-bp5 !P1 bucket 3 anchor 5.
#db-y4-bp0 !P1 bucket 4 anchor 0.
#db-y4-bp1 !P1 bucket 4 anchor 1.
#db-y4-bp2 !P1 bucket 4 anchor 2.
#db-y4-bp3 !P1 bucket 4 anchor 3.
#db-y4-bp4 !P1 bucket 4 anchor 4.
#db-y4-bp5 !P1 bucket 4 anchor 5.
#db-y5-bp0 !P1 terminal bucket anchor 0.
#db-y5-bp1 !P1 terminal bucket anchor 1.
#db-y5-bp2 !P1 terminal bucket anchor 2.
#db-y5-bp3 !P1 terminal bucket anchor 3.
#db-y5-bp4 !P1 terminal bucket anchor 4.
#db-y5-bp5 !P1 terminal bucket anchor 5.
#db2-y0-bp0 !P2 bucket 0 anchor 0.
#db2-y0-bp1 !P2 bucket 0 anchor 1.
#db2-y0-bp2 !P2 bucket 0 anchor 2.
#db2-y0-bp3 !P2 bucket 0 anchor 3.
#db2-y0-bp4 !P2 bucket 0 anchor 4.
#db2-y0-bp5 !P2 bucket 0 anchor 5.
#db2-y1-bp0 !P2 bucket 1 anchor 0.
#db2-y1-bp1 !P2 bucket 1 anchor 1.
#db2-y1-bp2 !P2 bucket 1 anchor 2.
#db2-y1-bp3 !P2 bucket 1 anchor 3.
#db2-y1-bp4 !P2 bucket 1 anchor 4.
#db2-y1-bp5 !P2 bucket 1 anchor 5.
#db2-y2-bp0 !P2 bucket 2 anchor 0.
#db2-y2-bp1 !P2 bucket 2 anchor 1.
#db2-y2-bp2 !P2 bucket 2 anchor 2.
#db2-y2-bp3 !P2 bucket 2 anchor 3.
#db2-y2-bp4 !P2 bucket 2 anchor 4.
#db2-y2-bp5 !P2 bucket 2 anchor 5.
#db2-y3-bp0 !P2 bucket 3 anchor 0.
#db2-y3-bp1 !P2 bucket 3 anchor 1.
#db2-y3-bp2 !P2 bucket 3 anchor 2.
#db2-y3-bp3 !P2 bucket 3 anchor 3.
#db2-y3-bp4 !P2 bucket 3 anchor 4.
#db2-y3-bp5 !P2 bucket 3 anchor 5.
#db2-y4-bp0 !P2 bucket 4 anchor 0.
#db2-y4-bp1 !P2 bucket 4 anchor 1.
#db2-y4-bp2 !P2 bucket 4 anchor 2.
#db2-y4-bp3 !P2 bucket 4 anchor 3.
#db2-y4-bp4 !P2 bucket 4 anchor 4.
#db2-y4-bp5 !P2 bucket 4 anchor 5.
#db2-y5-bp0 !P2 terminal bucket anchor 0.
#db2-y5-bp1 !P2 terminal bucket anchor 1.
#db2-y5-bp2 !P2 terminal bucket anchor 2.
#db2-y5-bp3 !P2 terminal bucket anchor 3.
#db2-y5-bp4 !P2 terminal bucket anchor 4.
#db2-y5-bp5 !P2 terminal bucket anchor 5.

#net-price-adjustment !Deducted from the strip price for product 1: transportCosts - benchmarkPremium ($/unit).
#net-price-adjustment-2 !Deducted from the strip price for product 2 ($/unit).

#oracle-price-timeout !Maximum frame age in seconds, measured from the frame's issued-at.
#price-min !Sanity band floor; halt if any weighted bucket price <= this.
#price-max !Sanity band ceiling; halt if any weighted bucket price >= this.

#price-multiplier !Multiplier applied to fair value. < 1 = discount, > 1 = premium.
#hard-floor !Never sell below this $/token (0 disables).
#hard-ceiling !Never buy above this $/token (must be > 0; set very large to disable).

/* ==========================================================
   CURVE-NPV PRICING (identical core to oil-token-curve-npv-dca.rain)
   Strip prices arrive as an oracle-signed context frame (see
   #frame-guards); freshness/signer/pair/meta checks are frame-level
   there. Every weighted bucket enforces the sanity band; buckets with
   zero interpolated weight skip it (Rainlang evaluates eagerly, and
   drained/disabled buckets carry price 0 which must not trip the band).
   ========================================================== */

/* Albion curve frame, schema v1 -- one signed context array (19 rows,
   all bytes32) attached by the taker to takeOrders4/quote2 and
   signature-verified by the orderbook against the trusted signer:
     row 0     : schema version (= 1)
     row 1     : input token address (left-padded bytes32)
     row 2     : output token address (left-padded bytes32)
     row 3     : issued-at, unix seconds
     row 4     : expires-at, unix seconds
     row 5     : metaHash of the canonical asset metadata
     row 6     : benchmark-1 id (1=Brent 2=WTI 3=NBP 4=TTF)
     row 7     : base-year (absolute calendar year of row 8)
     rows 8-12 : benchmark-1 prices, base-year+0 .. +4 (USD)
     row 13    : benchmark-2 id (0 = none)
     rows 14-18: benchmark-2 prices, base-year+0 .. +4 (0s when row 13 = 0)
   Rows are pinned positionally: signed-context operands are parse-time
   literals (no dynamic indexing in Rainlang), so year alignment is
   enforced by requiring row 7 == year-0.
   NOTE: no using-words-from here -- the on-chain parser accepts the
   pragma only at the top of the composed document, so it lives in the
   #calculate-io entrypoint and covers every called function. */
#frame-guards
:ensure(equal-to(signer<0>() oracle-signer) "untrusted signer"),
:ensure(equal-to(signed-context<0 0>() oracle-schema-version) "frame schema"),
:ensure(equal-to(signed-context<0 1>() input-token()) "frame input token"),
:ensure(equal-to(signed-context<0 2>() output-token()) "frame output token"),
issued: signed-context<0 3>(),
:ensure(greater-than-or-equal-to(now() issued) "frame from future"),
:ensure(less-than-or-equal-to(now() signed-context<0 4>()) "frame expired"),
:ensure(less-than(sub(now() issued) oracle-price-timeout) "frame too old"),
:ensure(equal-to(signed-context<0 5>() meta-hash) "meta-revised"),
:ensure(equal-to(signed-context<0 6>() benchmark-id) "benchmark mismatch"),
:ensure(equal-to(signed-context<0 7>() year-0) "base-year mismatch"),
:ensure(equal-to(signed-context<0 13>() benchmark-2-id) "benchmark2 mismatch");

/* Piecewise-linear interpolation across the 5 segments of one bucket. */
#bucket-interp
bp-a bp-b bp-c bp-d bp-e bp-f seg-index within:,
v0: add(bp-a mul(sub(bp-b bp-a) within)),
v1: add(bp-b mul(sub(bp-c bp-b) within)),
v2: add(bp-c mul(sub(bp-d bp-c) within)),
v3: add(bp-d mul(sub(bp-e bp-d) within)),
v4: add(bp-e mul(sub(bp-f bp-e) within)),
_: conditions(
     less-than(seg-index 1) v0
     less-than(seg-index 2) v1
     less-than(seg-index 3) v2
     less-than(seg-index 4) v3
     v4
   );

/* One bucket's contribution to fair value. The bucket's frame price is
   read once in #curve-npv-floor and passed in. The sanity-band check is
   skipped when the bucket's interpolated weight is zero (zeroed product
   2, drained past-year buckets carry price 0 which must not trip the
   band -- Rainlang evaluates eagerly). Freshness is frame-level in
   #frame-guards. A single shared ensure message is used across buckets
   to keep this a shared function. */
#bucket-contribution
price adj bp-a bp-b bp-c bp-d bp-e bp-f seg-index within:,
weight: call<'bucket-interp>(bp-a bp-b bp-c bp-d bp-e bp-f seg-index within),
in-band: every(greater-than(price price-min) less-than(price price-max)),
:ensure(any(is-zero(weight) in-band) "bucket price out of band"),
_: mul(weight max(0 sub(price adj)));

/* Fair value at now(): each bucket's interpolated discounted-unit
   weight, priced at the frame's strip rows. Terminal buckets (c5/d5)
   reuse the year-4 price (frame rows 12 / 18) -- the same
   strip-then-flat convention as before. Subparser words resolve via the
   #calculate-io entrypoint's document-top using-words-from pragma. */
#curve-npv-floor
p1-y0: signed-context<0 8>(),
p1-y1: signed-context<0 9>(),
p1-y2: signed-context<0 10>(),
p1-y3: signed-context<0 11>(),
p1-y4: signed-context<0 12>(),
p2-y0: signed-context<0 14>(),
p2-y1: signed-context<0 15>(),
p2-y2: signed-context<0 16>(),
p2-y3: signed-context<0 17>(),
p2-y4: signed-context<0 18>(),
elapsed: sub(now() start-time),
t-frac: min(div(elapsed bp-horizon) 1),
scaled: mul(t-frac 5),
seg-index: floor(scaled),
within: frac(scaled),
c0: call<'bucket-contribution>(p1-y0 net-price-adjustment db-y0-bp0 db-y0-bp1 db-y0-bp2 db-y0-bp3 db-y0-bp4 db-y0-bp5 seg-index within),
c1: call<'bucket-contribution>(p1-y1 net-price-adjustment db-y1-bp0 db-y1-bp1 db-y1-bp2 db-y1-bp3 db-y1-bp4 db-y1-bp5 seg-index within),
c2: call<'bucket-contribution>(p1-y2 net-price-adjustment db-y2-bp0 db-y2-bp1 db-y2-bp2 db-y2-bp3 db-y2-bp4 db-y2-bp5 seg-index within),
c3: call<'bucket-contribution>(p1-y3 net-price-adjustment db-y3-bp0 db-y3-bp1 db-y3-bp2 db-y3-bp3 db-y3-bp4 db-y3-bp5 seg-index within),
c4: call<'bucket-contribution>(p1-y4 net-price-adjustment db-y4-bp0 db-y4-bp1 db-y4-bp2 db-y4-bp3 db-y4-bp4 db-y4-bp5 seg-index within),
c5: call<'bucket-contribution>(p1-y4 net-price-adjustment db-y5-bp0 db-y5-bp1 db-y5-bp2 db-y5-bp3 db-y5-bp4 db-y5-bp5 seg-index within),
d0: call<'bucket-contribution>(p2-y0 net-price-adjustment-2 db2-y0-bp0 db2-y0-bp1 db2-y0-bp2 db2-y0-bp3 db2-y0-bp4 db2-y0-bp5 seg-index within),
d1: call<'bucket-contribution>(p2-y1 net-price-adjustment-2 db2-y1-bp0 db2-y1-bp1 db2-y1-bp2 db2-y1-bp3 db2-y1-bp4 db2-y1-bp5 seg-index within),
d2: call<'bucket-contribution>(p2-y2 net-price-adjustment-2 db2-y2-bp0 db2-y2-bp1 db2-y2-bp2 db2-y2-bp3 db2-y2-bp4 db2-y2-bp5 seg-index within),
d3: call<'bucket-contribution>(p2-y3 net-price-adjustment-2 db2-y3-bp0 db2-y3-bp1 db2-y3-bp2 db2-y3-bp3 db2-y3-bp4 db2-y3-bp5 seg-index within),
d4: call<'bucket-contribution>(p2-y4 net-price-adjustment-2 db2-y4-bp0 db2-y4-bp1 db2-y4-bp2 db2-y4-bp3 db2-y4-bp4 db2-y4-bp5 seg-index within),
d5: call<'bucket-contribution>(p2-y4 net-price-adjustment-2 db2-y5-bp0 db2-y5-bp1 db2-y5-bp2 db2-y5-bp3 db2-y5-bp4 db2-y5-bp5 seg-index within),
p1: add(add(add(c0 c1) add(c2 c3)) add(c4 c5)),
p2: add(add(add(d0 d1) add(d2 d3)) add(d4 d5)),
fair-value: add(p1 p2),
_: mul(fair-value price-multiplier);

#curve-npv-limit-io
_: max(call<'curve-npv-floor>() hard-floor);

#curve-npv-limit-io-inv
_: max(inv(call<'curve-npv-floor>()) inv(hard-ceiling));

/* ==========================================================
   ORDER LIFECYCLE
   ========================================================== */

#handle-add-order
:ensure(greater-than(bp-horizon 0) "horizon>0"),
:ensure(greater-than(price-multiplier 0) "mult>0"),
:ensure(less-than(price-min price-max) "band min<max"),
:ensure(greater-than(oracle-price-timeout 0) "timeout>0"),
:ensure(greater-than(oracle-schema-version 0) "schema>0"),
:ensure(greater-than(hard-ceiling 0) "ceiling>0"),
:ensure(greater-than-or-equal-to(hard-floor 0) "floor>=0"),
:ensure(greater-than-or-equal-to(benchmark-id 1) "benchmark low"),
:ensure(less-than-or-equal-to(benchmark-id 4) "benchmark high"),
:ensure(less-than-or-equal-to(benchmark-2-id 4) "benchmark2 high"),
:ensure(is-zero(sub(year-1 add(year-0 1))) "years 0-1"),
:ensure(is-zero(sub(year-2 add(year-1 1))) "years 1-2"),
:ensure(is-zero(sub(year-3 add(year-2 1))) "years 2-3"),
:ensure(is-zero(sub(year-4 add(year-3 1))) "years 3-4"),
total-a0: add(add(add(db-y0-bp0 db-y1-bp0) add(db-y2-bp0 db-y3-bp0)) add(db-y4-bp0 db-y5-bp0)),
total-a5: add(add(add(db-y0-bp5 db-y1-bp5) add(db-y2-bp5 db-y3-bp5)) add(db-y4-bp5 db-y5-bp5)),
:ensure(greater-than(total-a0 0) "bp0>0"),
:ensure(greater-than-or-equal-to(total-a0 total-a5) "endpoint"),
total2-a0: add(add(add(db2-y0-bp0 db2-y1-bp0) add(db2-y2-bp0 db2-y3-bp0)) add(db2-y4-bp0 db2-y5-bp0)),
total2-a5: add(add(add(db2-y0-bp5 db2-y1-bp5) add(db2-y2-bp5 db2-y3-bp5)) add(db2-y4-bp5 db2-y5-bp5)),
:ensure(any(is-zero(total2-a0) greater-than(benchmark-2-id 0)) "benchmark2 required"),
:ensure(greater-than-or-equal-to(total2-a0 total2-a5) "endpoint2");
/* No signed context exists at add time -- the metadata-revision guard
   lives in #frame-guards against the deploy-time meta-hash binding. */

#calculate-io
using-words-from raindex-subparser
:ensure(greater-than-or-equal-to(now() start-time) "not started"),
:ensure(less-than(now() add(start-time bp-horizon)) "curve-expired"),
:call<'frame-guards>(),
max-output: max-positive-value(),
io: call<'target-io-fn>();

#handle-io :;
