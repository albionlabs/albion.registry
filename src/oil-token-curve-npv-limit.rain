          name: Oracle price timeout
          description: >
            Maximum frame age in seconds, measured from the frame's own
            issued-at row. For a benchmark frame that row is the SETTLEMENT
            timestamp, not serve time, so the clock does not advance over
            weekends or market holidays. The default matches the server's
            validity window (96h), which makes the frame's own expires-at
            row the effective guard and avoids a predictable weekly halt --
            a Friday settlement is already >48h old by Sunday afternoon UTC.
            Tighter values are opt-in and WILL halt the order across normal
            settlement gaps. Note the flip side: this window is also taker
            optionality -- within it a taker may replay whichever signed
            frame prices most favourably, so shortening it trades
            availability for tighter pricing.
          show-custom-field: true
          default: 345600
          presets:
            - name: 4 days (345600) -- matches the server validity window
              value: 345600
            - name: 2 days (172800) -- halts over most weekends
              value: 172800
            - name: 1 day (86400) -- halts over any settlement gap
              value: 86400
        - binding: price-min
          name: Price sanity floor ($/unit)
          show-custom-field: true
          default: 10
        - binding: price-max
          name: Price sanity ceiling ($/unit)
          show-custom-field: true
          default: 500
        - binding: price-multiplier
          name: Price multiplier
          show-custom-field: true
          default: 0.80
        - binding: hard-floor
          name: Hard floor ($/token, 0 = disabled)
          show-custom-field: true
          default: 0
        - binding: hard-ceiling
          name: Hard ceiling ($/token)
          show-custom-field: true
          default: 1000000000
      select-tokens:
        - key: output
          name: Payment token to spend
          description: The settlement token you are spending (USDC).
        - key: input
          name: Royalty token to buy
          description: >
            The Albion royalty token you are buying. THIS side must be the
            Albion asset token -- asset-id binds to it and the oracle's asset
            frame is minted for the non-quote side of the pair.

---
#raindex-subparser !Raindex subparser.

#oracle-signer !Trusted EIP-191 signer of every consumed oracle frame.
#benchmark-schema-version !Expected benchmark frame schema version (= 2).
#asset-schema-version !Expected asset metahash frame schema version (= 3).
#benchmark-slot !Bundle slot of product 1's benchmark frame (0=Brent 1=WTI 2=NBP 3=TTF).
#benchmark-2-slot !Bundle slot of product 2's benchmark frame; inert when product-2-fn is 'product-2-off.
#asset-slot !Bundle slot of the asset metahash frame (4 in the /context/v1 bundle).
#asset-id !This order's royalty token address; must equal asset frame row 1 and be one side of the live pair.
#product-2-fn !Product 2 contribution: 'product-2-live reads a second benchmark slot, 'product-2-off returns 0.
#product-2-enabled !1 when product-2-fn is 'product-2-live, 0 when 'product-2-off. Scenario binding, never a GUI field.

#target-io-fn !Function computing the quoted io ratio (sell floor or buy inverse).

#benchmark-id !Product 1 benchmark: 1=Brent 2=WTI 3=NBP 4=TTF.
#benchmark-2-id !Product 2 benchmark; 0 disables product 2.
#meta-hash !Hash of the canonical asset metadata baked at deploy time.
#start-time !Unix timestamp anchoring grid breakpoint 0.
#bp-horizon !Seconds spanned by the 5 grid segments; order halts past start-time + bp-horizon.

#year-0 !Calendar year of bucket 0 (deploy year; oracle key holds Bal average).
#year-1 !Calendar year of bucket 1.
#year-2 !Calendar year of bucket 2.
#year-3 !Calendar year of bucket 3.
#year-4 !Calendar year of bucket 4; also prices the terminal bucket (strip-then-flat).

/* Curve-NPV grid (deploy-time scalars from computeBucketNpvGrid).
   Same layout as oil-token-curve-npv-dca.rain -- see that file. */
