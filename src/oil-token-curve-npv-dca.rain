          name: P2 Y3 BP1
        - binding: db2-y3-bp2
          name: P2 Y3 BP2
        - binding: db2-y3-bp3
          name: P2 Y3 BP3
        - binding: db2-y3-bp4
          name: P2 Y3 BP4
        - binding: db2-y3-bp5
          name: P2 Y3 BP5
        - binding: db2-y4-bp0
          name: P2 Y4 BP0
        - binding: db2-y4-bp1
          name: P2 Y4 BP1
        - binding: db2-y4-bp2
          name: P2 Y4 BP2
        - binding: db2-y4-bp3
          name: P2 Y4 BP3
        - binding: db2-y4-bp4
          name: P2 Y4 BP4
        - binding: db2-y4-bp5
          name: P2 Y4 BP5
        - binding: db2-y5-bp0
          name: P2 Terminal BP0
        - binding: db2-y5-bp1
          name: P2 Terminal BP1
        - binding: db2-y5-bp2
          name: P2 Terminal BP2
        - binding: db2-y5-bp3
          name: P2 Terminal BP3
        - binding: db2-y5-bp4
          name: P2 Terminal BP4
        - binding: db2-y5-bp5
          name: P2 Terminal BP5
        - binding: net-price-adjustment
          name: Net price adjustment ($/unit, product 1)
          description: 'Deducted from the strip price: transportCosts - benchmarkPremium.'
        - binding: net-price-adjustment-2
          name: Net price adjustment ($/unit, product 2)
        - binding: oracle-price-timeout
          name: Oracle price timeout
          description: Maximum frame age in seconds, measured from the frame's issued-at.
          show-custom-field: true
          default: 172800
          presets:
            - name: 1 day (86400)
              value: 86400
            - name: 2 days (172800)
              value: 172800
            - name: 4 days (345600)
              value: 345600
        - binding: price-min
          name: Price sanity floor ($/unit)
          description: Halt if any weighted bucket price is at or below this.
          show-custom-field: true
          default: 10
        - binding: price-max
          name: Price sanity ceiling ($/unit)
          description: Halt if any weighted bucket price is at or above this.
          show-custom-field: true
          default: 500
        - binding: price-multiplier
          name: Price multiplier
          description: 'Multiplier applied to fair value. Example: 0.80 = 20% discount, 1.05 = 5% premium.'
          show-custom-field: true
          default: 0.80
        - binding: hard-floor
          name: Hard floor ($/token, 0 = disabled)
          description: Never sell below this price regardless of the computed fair value.
          show-custom-field: true
          default: 0
        - binding: hard-ceiling
          name: Hard ceiling ($/token)
          description: Never buy above this price. Set very large to disable (must be > 0).
          show-custom-field: true
          default: 1000000000
        - binding: time-per-amount-epoch
          name: Budget period (in seconds)
          description: The budget is spent over this time period.
          show-custom-field: true
          presets:
            - name: Per hour (3600)
              value: 3600
            - name: Per day (86400)
              value: 86400
            - name: Per week (604800)
              value: 604800
            - name: Per 30 days (2592000)
              value: 2592000
        - binding: amount-per-epoch
          name: Budget (${order.outputs.0.token.symbol} per period)
          description: Amount of ${order.outputs.0.token.symbol} to sell each budget period.
        - binding: max-trade-amount
          name: Maximum trade size (${order.outputs.0.token.symbol})
        - binding: min-trade-amount
          name: Minimum trade size (${order.outputs.0.token.symbol})
        - binding: time-per-trade-epoch
          name: Auction period (in seconds)
          description: Time between each auction price halvening.
          show-custom-field: true
          default: 3600
          presets:
            - name: Every 20 minutes (1200)
              value: 1200
            - name: Every hour (3600)
              value: 3600
            - name: Every 6 hours (21600)
              value: 21600
            - name: Every 24 hours (86400)
              value: 86400
        - binding: next-trade-multiplier
          name: Auction start multiplier
          description: Multiplier to apply to the last trade to kick off the next auction.
          show-custom-field: true
          default: 1.01
          presets:
            - name: 1.01x
              value: 1.01
            - name: 1.05x
              value: 1.05
            - name: 1.10x
              value: 1.10
      select-tokens:
        - key: output
          name: Token to Sell
          description: Select the reserve token you want to sell
        - key: input
          name: Token to Buy
          description: Select the payment token you want to receive

    buy:
      name: Buy - Curve NPV DCA
      description: Inverse orientation -- buy reserve tokens against the curve-NPV floor.
      deposits:
