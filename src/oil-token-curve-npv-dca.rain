        - binding: db2-y2-bp5
          name: P2 Y2 BP5
        - binding: db2-y3-bp0
          name: P2 Y3 BP0
        - binding: db2-y3-bp1
          name: P2 Y3 BP1
        - binding: db2-y3-bp2
          name: P2 Y3 BP2
        - binding: db2-y3-bp3
          name: P2 Y3 BP3
        - binding: db2-y3-bp4
          name: P2 Y3 BP4
        - binding: db2-y3-bp5
          name: P2 Y3 BP5
        - binding: db2-y4-bp0
          name: P2 Y4 BP0
        - binding: db2-y4-bp1
          name: P2 Y4 BP1
        - binding: db2-y4-bp2
          name: P2 Y4 BP2
        - binding: db2-y4-bp3
          name: P2 Y4 BP3
        - binding: db2-y4-bp4
          name: P2 Y4 BP4
        - binding: db2-y4-bp5
          name: P2 Y4 BP5
        - binding: db2-y5-bp0
          name: P2 Terminal BP0
