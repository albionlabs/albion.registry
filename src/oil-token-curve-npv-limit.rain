version: 5

orders:
  base:
    orderbook: base
    # TODO(albion.oracle-server): placeholder; runtime-injected by the client
    # (like the RPC URL) once the production oracle server is live. The taker
    # fetches an oracle-signed context frame from this URL per trade.
    oracle-url: https://oracle.albionlabs.org/context/v1
    inputs:
      - token: input
    outputs:
      - token: output

scenarios:
  # Fixed-limit execution over the same curve-NPV pricing core as
  # oil-token-curve-npv-dca.rain: baked discounted-production buckets
  # valued at live Bal/Cal strip levels carried in an oracle-signed
  # context frame (SignedContextV1) attached by the taker and
  # signature-verified by the orderbook -- no on-chain oracle contract.
  # The order continuously offers the full vault balance at the
  # curve-NPV floor (sell) or its inverse (buy). Halts (never
  # misprices) on stale frames, out-of-band prices, metadata revisions,
  # or curve expiry.
  # Grid from computeBucketNpvGrid in src/lib/services/deploymentArgs.ts.
  # Spec: docs/superpowers/specs/2026-07-03-curve-npv-oracle-strategy-design.md (s15)
  oil-curve-npv-limit:
    orderbook: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      # TODO(albion.oracle-server): placeholder; runtime-injected with the
      # production oracle signer address. Integration tests patch this with
      # a throwaway signing key.
      oracle-signer: 0x0000000000000000000000000000000000000000
      oracle-schema-version: 1
      target-io-fn: '''curve-npv-limit-io'

  oil-curve-npv-limit-inv:
    orderbook: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      oracle-signer: 0x0000000000000000000000000000000000000000
      oracle-schema-version: 1
      target-io-fn: '''curve-npv-limit-io-inv'

deployments:
  sell:
    order: base
    scenario: oil-curve-npv-limit
  buy:
    order: base
    scenario: oil-curve-npv-limit-inv

gui:
  name: Oil & gas curve-NPV limit
  description: >
    Fixed limit order at the forward-strip NPV: baked discounted-production
    buckets (per calendar year) are valued at live Bal/Cal swap levels from
    the Albion curve oracle. Offers the full deposited balance at the
    curve-NPV floor. Halts (never misprices) on stale curves, out-of-band
    prices, metadata revisions, or curve expiry.
  short-description: >
    Limit order priced off the live forward strip (curve-NPV floor).

  deployments:
    sell:
      name: Sell - Curve NPV limit
      description: >
        Sell continuously at the forward-strip NPV of baked production
        buckets (times the price multiplier).
      deposits:
        - token: output
      fields:
        - binding: benchmark-id
          name: Benchmark (1=Brent 2=WTI 3=NBP 4=TTF)
          description: Product 1 price benchmark identifier.
        - binding: benchmark-2-id
          name: Benchmark 2 (0=disabled)
          description: Product 2 price benchmark identifier; 0 for single-product assets.
        - binding: meta-hash
          name: Metadata hash
          description: Hash of the canonical asset metadata at deploy time.
        - binding: start-time
          name: Start time
          description: Unix timestamp anchoring breakpoint 0.
        - binding: bp-horizon
          name: Breakpoint horizon (seconds)
          description: Span of the 5 grid segments; the order halts when now exceeds start-time + horizon.
        - binding: year-0
          name: Bucket year 0 (current)
        - binding: year-1
          name: Bucket year 1
        - binding: year-2
          name: Bucket year 2
        - binding: year-3
          name: Bucket year 3
        - binding: year-4
          name: Bucket year 4 (also prices the terminal bucket)
        - binding: db-y0-bp0
          name: P1 Y0 BP0
          description: Discounted units/token, product 1, bucket year-0, anchor 0. All grid cells from computeBucketNpvGrid.
        - binding: db-y0-bp1
          name: P1 Y0 BP1
        - binding: db-y0-bp2
          name: P1 Y0 BP2
        - binding: db-y0-bp3
          name: P1 Y0 BP3
        - binding: db-y0-bp4
          name: P1 Y0 BP4
        - binding: db-y0-bp5
          name: P1 Y0 BP5
        - binding: db-y1-bp0
          name: P1 Y1 BP0
        - binding: db-y1-bp1
          name: P1 Y1 BP1
        - binding: db-y1-bp2
          name: P1 Y1 BP2
        - binding: db-y1-bp3
          name: P1 Y1 BP3
        - binding: db-y1-bp4
          name: P1 Y1 BP4
        - binding: db-y1-bp5
          name: P1 Y1 BP5
        - binding: db-y2-bp0
          name: P1 Y2 BP0
        - binding: db-y2-bp1
          name: P1 Y2 BP1
        - binding: db-y2-bp2
          name: P1 Y2 BP2
        - binding: db-y2-bp3
          name: P1 Y2 BP3
        - binding: db-y2-bp4
          name: P1 Y2 BP4
        - binding: db-y2-bp5
          name: P1 Y2 BP5
        - binding: db-y3-bp0
          name: P1 Y3 BP0
        - binding: db-y3-bp1
          name: P1 Y3 BP1
        - binding: db-y3-bp2
          name: P1 Y3 BP2
        - binding: db-y3-bp3
          name: P1 Y3 BP3
        - binding: db-y3-bp4
          name: P1 Y3 BP4
        - binding: db-y3-bp5
          name: P1 Y3 BP5
        - binding: db-y4-bp0
          name: P1 Y4 BP0
        - binding: db-y4-bp1
          name: P1 Y4 BP1
        - binding: db-y4-bp2
          name: P1 Y4 BP2
