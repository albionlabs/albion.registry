version: 5

orders:
  base:
    raindex: base
    # PLACEHOLDER -- DO NOT EDIT THE VALUE. Injected at deploy by the
    # consumer: albion.dex src/lib/clients/rainStrategies.ts holds the
    # `oracle-url:` and `oracle-signer:` lines below as exact string
    # constants (ORACLE_URL_PLACEHOLDER / ORACLE_SIGNER_PLACEHOLDER) and
    # rewrites them with `replaceAll`, substituting PUBLIC_CURVE_ORACLE_URL +
    # PUBLIC_CURVE_ORACLE_SIGNER. Writing a real URL or signer here makes
    # that replaceAll a silent no-op and pins EVERY environment --
    # production included -- to whatever was hard-coded. The zero-address
    # signer is the fail-safe: unconfigured envs leave the placeholders
    # untouched and the UI blocks the deploy (isCurveOracleConfigured()).
    #
    # Environments, for reference only (spec s16.6, /status verified
    # 2026-07-30). Never paste these into the template:
    #   staging     https://albion-oracle-mrflki6foq-ey.a.run.app
    #               signer 0xCEd8AAb28809FbeAa9DE9E576A6255663C58DC78
    #   production  https://albion-oracle-nu5w4hcuuq-ey.a.run.app
    #               signer 0x818D8Db28E07eaE7c75026D53cA4CCBeB5ee7b3D
    # URL and signer are one unit: either alone halts every order. A KMS
    # cryptoKeyVersion bump changes the signer address, so signer rotation
    # is a strategy migration, not an ops action.
    oracle-url: https://oracle.albionlabs.org/context/v1
    inputs:
      - token: input
    outputs:
      - token: output

scenarios:
  # Fixed-limit execution over the same curve-NPV pricing core as
  # oil-token-curve-npv-dca.rain: baked discounted-production buckets
  # valued at live Bal/Cal strip levels carried in an oracle-signed
  # context frame (SignedContextV1) attached by the taker and
  # signature-verified by the orderbook -- no on-chain oracle contract.
  # The order continuously offers the full vault balance at the
  # curve-NPV floor (sell) or its inverse (buy). Halts (never
  # misprices) on stale frames, out-of-band prices, metadata revisions,
  # or curve expiry.
  # Grid from computeBucketNpvGrid in albion.dex
  # src/lib/services/deploymentArgs.ts.
  # Migrated 2026-07-30 from the s15 19-row single frame to the AS-BUILT
  # 5-frame bundle. Normative frame reference: albionlabs/albion.oracle-server
  # README.md + src/oracle.rs. Rationale: design spec s16.
  oil-curve-npv-limit:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      # PLACEHOLDER -- DO NOT EDIT THE VALUE. Injected at deploy alongside
      # `oracle-url` (see the comment in the order block). The zero address
      # is deliberately fail-safe: it matches no real signer, so an
      # un-injected template cannot produce a tradeable order. Integration
      # tests patch this with a throwaway signing key.
      oracle-signer: 0x0000000000000000000000000000000000000000
      benchmark-schema-version: 2
      asset-schema-version: 3
      # Slot pinning -- spec s16.4(c) option (i). The /context/v1 bundle
      # order is FIXED and positional:
      #   [0] Brent  [1] WTI  [2] NBP  [3] TTF  [4] asset metahash
      # Wressle-1 is Brent-linked, so benchmark-slot 0. A gas asset needs a
      # sibling scenario pinning 2 (NBP) or 3 (TTF); nothing else changes.
      benchmark-slot: 0
      asset-slot: 4
      # Series ids are scenario bindings, not GUI fields: handle-add-order
      # requires benchmark-slot == benchmark-id - 1, so with the slot pinned
      # per scenario there is exactly one non-reverting id. Supporting
      # WTI/NBP/TTF means a sibling scenario binding both slot and id
      # together (1/2, 2/3, 3/4) -- the spec's slot-pinning decision
      # (s16.4(c) option (i)) makes the pair a deploy-time constant.
      benchmark-id: 1
      # Single-product asset: product 2 is disabled by never reading a
      # second benchmark slot (spec s16.4(c)), so it costs no signer /
      # schema / freshness guard set. benchmark-2-slot / benchmark-2-id are
      # inert here but kept internally consistent (slot 1 == WTI == id 2) so
      # flipping product-2-fn to 'product-2-live needs no other edit.
      product-2-fn: '''product-2-off'
      product-2-enabled: 0
      benchmark-2-slot: 1
      benchmark-2-id: 2
      # The oracle derives the asset from the order's IO pair (whichever
      # side is not the quote token), so this must name the same side.
      asset-id: ${order.outputs.0.token.address}
      target-io-fn: '''curve-npv-limit-io'

  oil-curve-npv-limit-inv:
    raindex: base
    rainlang: base
    runs: 1
    bindings:
      raindex-subparser: 0x22839F16281E67E5Fd395fAFd1571e820CbD46cB
      # PLACEHOLDER -- injected at deploy. See the first scenario.
      oracle-signer: 0x0000000000000000000000000000000000000000
      benchmark-schema-version: 2
      asset-schema-version: 3
      # Slot pinning -- spec s16.4(c) option (i). The /context/v1 bundle
      # order is FIXED and positional:
      #   [0] Brent  [1] WTI  [2] NBP  [3] TTF  [4] asset metahash
      # Wressle-1 is Brent-linked, so benchmark-slot 0. A gas asset needs a
      # sibling scenario pinning 2 (NBP) or 3 (TTF); nothing else changes.
      benchmark-slot: 0
      asset-slot: 4
      # Series ids are scenario bindings, not GUI fields: handle-add-order
      # requires benchmark-slot == benchmark-id - 1, so with the slot pinned
      # per scenario there is exactly one non-reverting id. Supporting
      # WTI/NBP/TTF means a sibling scenario binding both slot and id
      # together (1/2, 2/3, 3/4) -- the spec's slot-pinning decision
      # (s16.4(c) option (i)) makes the pair a deploy-time constant.
      benchmark-id: 1
      # Single-product asset: product 2 is disabled by never reading a
      # second benchmark slot (spec s16.4(c)), so it costs no signer /
      # schema / freshness guard set. benchmark-2-slot / benchmark-2-id are
      # inert here but kept internally consistent (slot 1 == WTI == id 2) so
      # flipping product-2-fn to 'product-2-live needs no other edit.
      product-2-fn: '''product-2-off'
      product-2-enabled: 0
      benchmark-2-slot: 1
      benchmark-2-id: 2
      # The oracle derives the asset from the order's IO pair (whichever
      # side is not the quote token), so this must name the same side.
      asset-id: ${order.inputs.0.token.address}
      target-io-fn: '''curve-npv-limit-io-inv'

deployments:
  sell:
    order: base
    scenario: oil-curve-npv-limit
  buy:
    order: base
    scenario: oil-curve-npv-limit-inv

gui:
  name: Oil & gas curve-NPV limit
  description: >
    Fixed limit order at the forward-strip NPV: baked discounted-production
    buckets (per calendar year) are valued at live Bal/Cal swap levels from
    the Albion curve oracle. Offers the full deposited balance at the
    curve-NPV floor. Halts (never misprices) on stale curves, out-of-band
    prices, metadata revisions, or curve expiry.
  short-description: >
    Limit order priced off the live forward strip (curve-NPV floor).

  deployments:
    sell:
      name: Sell - Curve NPV limit
      description: >
        Sell continuously at the forward-strip NPV of baked production
        buckets (times the price multiplier).
      deposits:
        - token: output
      fields:
        - binding: meta-hash
          name: Metadata hash
          description: Hash of the canonical asset metadata at deploy time.
        - binding: start-time
          name: Start time
          description: Unix timestamp anchoring breakpoint 0.
        - binding: bp-horizon
          name: Breakpoint horizon (seconds)
          description: Span of the 5 grid segments; the order halts when now exceeds start-time + horizon.
        - binding: year-0
          name: Bucket year 0 (current)
        - binding: year-1
          name: Bucket year 1
        - binding: year-2
          name: Bucket year 2
        - binding: year-3
          name: Bucket year 3
        - binding: year-4
          name: Bucket year 4 (also prices the terminal bucket)
        - binding: db-y0-bp0
          name: P1 Y0 BP0
          description: Discounted units/token, product 1, bucket year-0, anchor 0. All grid cells from computeBucketNpvGrid.
        - binding: db-y0-bp1
          name: P1 Y0 BP1
        - binding: db-y0-bp2
          name: P1 Y0 BP2
        - binding: db-y0-bp3
          name: P1 Y0 BP3
        - binding: db-y0-bp4
          name: P1 Y0 BP4
        - binding: db-y0-bp5
          name: P1 Y0 BP5
        - binding: db-y1-bp0
          name: P1 Y1 BP0
        - binding: db-y1-bp1
          name: P1 Y1 BP1
        - binding: db-y1-bp2
          name: P1 Y1 BP2
        - binding: db-y1-bp3
          name: P1 Y1 BP3
        - binding: db-y1-bp4
          name: P1 Y1 BP4
        - binding: db-y1-bp5
          name: P1 Y1 BP5
        - binding: db-y2-bp0
          name: P1 Y2 BP0
        - binding: db-y2-bp1
          name: P1 Y2 BP1
        - binding: db-y2-bp2
          name: P1 Y2 BP2
        - binding: db-y2-bp3
          name: P1 Y2 BP3
        - binding: db-y2-bp4
          name: P1 Y2 BP4
        - binding: db-y2-bp5
          name: P1 Y2 BP5
        - binding: db-y3-bp0
          name: P1 Y3 BP0
        - binding: db-y3-bp1
          name: P1 Y3 BP1
        - binding: db-y3-bp2
          name: P1 Y3 BP2
        - binding: db-y3-bp3
          name: P1 Y3 BP3
        - binding: db-y3-bp4
          name: P1 Y3 BP4
        - binding: db-y3-bp5
          name: P1 Y3 BP5
        - binding: db-y4-bp0
          name: P1 Y4 BP0
        - binding: db-y4-bp1
          name: P1 Y4 BP1
        - binding: db-y4-bp2
          name: P1 Y4 BP2
        - binding: db-y4-bp3
          name: P1 Y4 BP3
        - binding: db-y4-bp4
          name: P1 Y4 BP4
        - binding: db-y4-bp5
          name: P1 Y4 BP5
        - binding: db-y5-bp0
          name: P1 Terminal BP0
        - binding: db-y5-bp1
          name: P1 Terminal BP1
        - binding: db-y5-bp2
          name: P1 Terminal BP2
        - binding: db-y5-bp3
          name: P1 Terminal BP3
        - binding: db-y5-bp4
          name: P1 Terminal BP4
        - binding: db-y5-bp5
          name: P1 Terminal BP5
        - binding: db2-y0-bp0
          name: P2 Y0 BP0
          description: Product 2 grid; all zeros for single-product assets.
        - binding: db2-y0-bp1
          name: P2 Y0 BP1
        - binding: db2-y0-bp2
          name: P2 Y0 BP2
        - binding: db2-y0-bp3
          name: P2 Y0 BP3
        - binding: db2-y0-bp4
          name: P2 Y0 BP4
        - binding: db2-y0-bp5
          name: P2 Y0 BP5
        - binding: db2-y1-bp0
          name: P2 Y1 BP0
        - binding: db2-y1-bp1
          name: P2 Y1 BP1
        - binding: db2-y1-bp2
          name: P2 Y1 BP2
        - binding: db2-y1-bp3
          name: P2 Y1 BP3
        - binding: db2-y1-bp4
          name: P2 Y1 BP4
        - binding: db2-y1-bp5
          name: P2 Y1 BP5
        - binding: db2-y2-bp0
          name: P2 Y2 BP0
        - binding: db2-y2-bp1
          name: P2 Y2 BP1
        - binding: db2-y2-bp2
          name: P2 Y2 BP2
        - binding: db2-y2-bp3
          name: P2 Y2 BP3
        - binding: db2-y2-bp4
          name: P2 Y2 BP4
        - binding: db2-y2-bp5
          name: P2 Y2 BP5
        - binding: db2-y3-bp0
          name: P2 Y3 BP0
        - binding: db2-y3-bp1
          name: P2 Y3 BP1
        - binding: db2-y3-bp2
          name: P2 Y3 BP2
        - binding: db2-y3-bp3
          name: P2 Y3 BP3
        - binding: db2-y3-bp4
          name: P2 Y3 BP4
        - binding: db2-y3-bp5
          name: P2 Y3 BP5
        - binding: db2-y4-bp0
          name: P2 Y4 BP0
        - binding: db2-y4-bp1
          name: P2 Y4 BP1
        - binding: db2-y4-bp2
          name: P2 Y4 BP2
        - binding: db2-y4-bp3
          name: P2 Y4 BP3
        - binding: db2-y4-bp4
          name: P2 Y4 BP4
        - binding: db2-y4-bp5
          name: P2 Y4 BP5
        - binding: db2-y5-bp0
          name: P2 Terminal BP0
        - binding: db2-y5-bp1
          name: P2 Terminal BP1
        - binding: db2-y5-bp2
          name: P2 Terminal BP2
        - binding: db2-y5-bp3
          name: P2 Terminal BP3
        - binding: db2-y5-bp4
          name: P2 Terminal BP4
        - binding: db2-y5-bp5
          name: P2 Terminal BP5
        - binding: net-price-adjustment
          name: Net price adjustment ($/unit, product 1)
          description: 'Deducted from the strip price: transportCosts - benchmarkPremium.'
        - binding: net-price-adjustment-2
          name: Net price adjustment ($/unit, product 2)
        - binding: oracle-price-timeout
          name: Oracle price timeout
          description: >
            Maximum frame age in seconds, measured from the frame's own
            issued-at row. For a benchmark frame that row is the SETTLEMENT
            timestamp, not serve time, so the clock does not advance over
            weekends or market holidays. The default matches the server's
            validity window (96h), which makes the frame's own expires-at
            row the effective guard and avoids a predictable weekly halt --
            a Friday settlement is already >48h old by Sunday afternoon UTC.
            Tighter values are opt-in and WILL halt the order across normal
            settlement gaps. Note the flip side: this window is also taker
            optionality -- within it a taker may replay whichever signed
            frame prices most favourably, so shortening it trades
            availability for tighter pricing.
          show-custom-field: true
          default: 345600
          presets:
            - name: 4 days (345600) -- matches the server validity window
              value: 345600
            - name: 2 days (172800) -- halts over most weekends
              value: 172800
            - name: 1 day (86400) -- halts over any settlement gap
              value: 86400
        - binding: price-min
          name: Price sanity floor ($/unit)
          show-custom-field: true
          default: 10
        - binding: price-max
          name: Price sanity ceiling ($/unit)
          show-custom-field: true
          default: 500
        - binding: price-multiplier
          name: Price multiplier
          description: 'Multiplier applied to fair value. Example: 0.80 = 20% discount, 1.05 = 5% premium.'
          show-custom-field: true
          default: 0.80
        - binding: hard-floor
          name: Hard floor ($/token, 0 = disabled)
          show-custom-field: true
          default: 0
        - binding: hard-ceiling
          name: Hard ceiling ($/token)
          description: Never buy above this price. Set very large to disable (must be > 0).
          show-custom-field: true
          default: 1000000000
      select-tokens:
        - key: output
          name: Royalty token to sell
          description: >
            The Albion royalty token you are selling. THIS side must be the
            Albion asset token -- asset-id binds to it and the oracle's asset
            frame is minted for the non-quote side of the pair.
        - key: input
          name: Payment token to receive
          description: The settlement token you receive (USDC).

    buy:
      name: Buy - Curve NPV limit
      description: Inverse orientation -- buy reserve tokens at the curve-NPV floor.
      deposits:
        - token: output
      fields:
        - binding: meta-hash
          name: Metadata hash
        - binding: start-time
          name: Start time
        - binding: bp-horizon
          name: Breakpoint horizon (seconds)
        - binding: year-0
          name: Bucket year 0 (current)
        - binding: year-1
          name: Bucket year 1
        - binding: year-2
          name: Bucket year 2
        - binding: year-3
          name: Bucket year 3
        - binding: year-4
          name: Bucket year 4 (also prices the terminal bucket)
        - binding: db-y0-bp0
          name: P1 Y0 BP0
        - binding: db-y0-bp1
          name: P1 Y0 BP1
        - binding: db-y0-bp2
          name: P1 Y0 BP2
